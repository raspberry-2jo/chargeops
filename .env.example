# ==============================================
# 환경변수 양식 — 값은 비워둔 채로만 커밋함
# 사용법: 이 파일을 복사해 .env를 만들고 각자 값을 채움
#   cp .env.example .env
# .env는 .gitignore로 막혀 있어서 커밋되지 않음
# ==============================================

# ----- DB (PostgreSQL / PgBouncer) -----
DB_HOST=
DB_PORT=6432
DB_NAME=chargeops
DB_USER=
DB_PASSWORD=

# ----- 공공 API -----
PUBLIC_API_KEY=
# 수집 범위 시도 코드 (50 = 제주, 2026-10-12 결정). 비우면 전국이라 하루 1,000회 한도에 금방 닿음
EV_ZCODE=50

# ----- Slack -----
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ----- Discord · 메일 (대체 알림) -----
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# ----- AWS (Bedrock · S3) -----
AWS_REGION=ap-northeast-2
AWS_PROFILE=
S3_BUCKET_RAW=
S3_BUCKET_BACKUP=
# S3 호환 저장소(온프렘 MinIO) 주소. 실제 AWS S3를 쓰면 비움
S3_ENDPOINT_URL=

# ----- CSMS -----
CSMS_WS_PORT=
