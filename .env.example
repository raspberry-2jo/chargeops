# ==============================================
# 환경변수 양식 — 값은 비워둔 채로만 커밋함
# 사용법: 이 파일을 복사해 .env를 만들고 각자 값을 채움
#   cp .env.example .env
# .env는 .gitignore로 막혀 있어서 커밋되지 않음
# ==============================================

# ----- DB (PostgreSQL / PgBouncer) -----
DB_HOST=
DB_PORT=6432
DB_NAME=chargeops
DB_USER=
DB_PASSWORD=

# ----- 공공 API -----
PUBLIC_API_KEY=

# ----- Slack -----
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ----- Discord · 메일 (대체 알림) -----
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# ----- AWS (Bedrock · S3) -----
AWS_REGION=ap-northeast-2
AWS_PROFILE=
S3_BUCKET_RAW=
S3_BUCKET_BACKUP=

# ----- CSMS -----
CSMS_WS_PORT=
