# ChargeOps 공공 API 수집기 이미지 (데이터팀 Containerfile 과 같은 구성 + S3 업로드용 boto3)
#   mgmt 에서 만들기:  docker build -t registry.chargeops.lab:5000/chargeops/collector:0.1 -f Containerfile .
#   실행 예: python collector_v1.py status   (접속 정보 · 인증키는 환경변수 — K8s 의 ConfigMap · Secret)
FROM docker.io/library/python:3.13-slim

# 출력이 바로 보이게(kubectl logs), pip 캐시를 남기지 않게(이미지 크기)
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
# 패키지 목록을 코드보다 먼저 → 코드만 고쳤을 때 이 단계는 캐시로 건너뜀
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY collector_v1.py .
# root 가 아닌 사용자로 (컨테이너 탈출 시 피해 축소). /data(PVC) 쓰기를 위해 그룹 0 권한
RUN useradd -u 10001 -g 0 -M app
USER 10001

ENTRYPOINT ["python", "collector_v1.py"]
CMD ["check"]
