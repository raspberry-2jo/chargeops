   "interval": "20s",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 12
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true,
      "lineInterpolation": "smooth",
      "thresholdsStyle": {
       "mode": "off"
      },
      "scaleDistribution": {
       "type": "log",
       "log": 10
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "p95"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e03131"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "평균"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#f08c00"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.95, sum by(le)(rate(chargeops_ocpp_handle_seconds_bucket[2m])))",
     "legendFormat": "p95",
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(chargeops_ocpp_handle_seconds_sum[2m])) / sum(rate(chargeops_ocpp_handle_seconds_count[2m]))",
     "legendFormat": "평균",
     "range": true
    }
   ]
  },
  {
