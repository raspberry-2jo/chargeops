      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(chargeops_ocpp_messages_total[2m]))",
     "instant": true
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Latency p95",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 3,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#2f9e44",
        "value": null
       },
       {
        "color": "#f08c00",
        "value": 0.1
       },
       {
        "color": "#e03131",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "horizontal",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center",
    "text": {
     "valueSize": 30
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.95, sum by(le)(rate(chargeops_ocpp_handle_seconds_bucket[2m])))",
     "instant": true
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "실패율",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 2,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#2f9e44",
        "value": null
       },
       {
        "color": "#f08c00",
        "value": 1
       },
       {
        "color": "#e03131",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "horizontal",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center",
    "text": {
     "valueSize": 30
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "100 * sum(rate(chargeops_ocpp_handler_results_total{result=~\"error|timeout\"}[2m])) / sum(rate(chargeops_ocpp_handler_results_total[2m])) or vector(0)",
     "instant": true
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "워커 CPU (높은 쪽)",
   "description": "목표 70%",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#2f9e44",
        "value": null
       },
       {
        "color": "#f08c00",
        "value": 70
       },
       {
        "color": "#e03131",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "horizontal",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center",
    "text": {
     "valueSize": 30
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "label_replace(label_replace(label_replace(max(100 - avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"10.10.20.(21|22):.*\"}[2m])) * 100), \"instance\", \"k8s-w01\", \"instance\", \"10.10.20.21:.*\"), \"instance\", \"k8s-w02\", \"instance\", \"10.10.20.22:.*\"), \"instance\", \"k8s-cp01\", \"instance\", \"10.10.20.11:.*\")",
     "instant": true
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "DB CPU (db-01)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#2f9e44",
        "value": null
       },
       {
        "color": "#f08c00",
        "value": 70
       },
       {
        "color": "#e03131",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "horizontal",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center",
    "text": {
     "valueSize": 30
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\",instance=\"db-01\"}[2m])) * 100",
     "instant": true
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "처리량: TPS · 충전기 연결 수",
   "description": "충전기를 늘려도 TPS가 더 오르지 않으면 = 처리량 포화 지점",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "interval": "20s",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 12
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true,
      "lineInterpolation": "smooth",
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       }
      ]
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "TPS"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#2f9e44"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "충전기 연결 수"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#868e96"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "충전기 연결 수"
      },
      "properties": [
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          8,
          6
         ]
        }
       },
       {
        "id": "min",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(chargeops_ocpp_messages_total[2m]))",
     "legendFormat": "TPS",
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(chargeops_csms_connections)",
     "legendFormat": "충전기 연결 수",
     "range": true
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "응답 시간: Latency p95 · 평균",
   "description": "로그 축. 평평하다가 위로 꺾이는 지점 = 한계. 합격 기준 1초는 위 p95 카드 색으로 확인",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
